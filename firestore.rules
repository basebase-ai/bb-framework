rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // apps collection
    match /apps/{doc} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.owner || request.auth.uid in resource.data.get('collaborators', []));
      allow update: if request.auth != null && (request.auth.uid == resource.data.owner || request.auth.uid in resource.data.get('collaborators', []));
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }

    // users collection
    match /users/{doc} {
      allow read: if request.auth != null;
      allow update: if request.auth.uid == doc;
      allow create: if request.auth != null;
      allow delete: if false;
    }
  }
}
