rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Extract app-id from collection name
    function getAppIdFromCollection(collection) {
      // "teg-app_ideas" → "teg-app"
      return collection.split('_')[0];
    }
    
    // Helper function: Check if user has active membership to read app data
    function canAccessApp(appId) {
      return request.auth != null
             && (get(/databases/$(database)/documents/apps/$(appId)).data.owner == request.auth.uid
                 || (exists(/databases/$(database)/documents/app-members/$(appId + '_' + request.auth.uid))
                     && get(/databases/$(database)/documents/app-members/$(appId + '_' + request.auth.uid)).data.status == 'active')
                 || get(/databases/$(database)/documents/apps/$(appId)).data.get('accessMode', 'open') == 'open');
    }
    
    // Helper function: Check if user can write to app collections
    function canWriteToApp(appId) {
      return request.auth != null
             && (get(/databases/$(database)/documents/apps/$(appId)).data.owner == request.auth.uid
                 || (exists(/databases/$(database)/documents/app-members/$(appId + '_' + request.auth.uid))
                     && get(/databases/$(database)/documents/app-members/$(appId + '_' + request.auth.uid)).data.status == 'active'
                     && get(/databases/$(database)/documents/app-members/$(appId + '_' + request.auth.uid)).data.role in ['admin', 'member']));
    }

    // Global: apps collection
    match /apps/{appId} {
      allow read: if true;  // Anyone can read app metadata
      allow create: if request.auth != null 
                    && request.resource.data.owner == request.auth.uid;
      
      // Owners can update anything
      allow update: if request.auth != null 
                    && request.auth.uid == resource.data.owner;
      
      // Collaborators can update version pointer when committing code
      allow update: if request.auth != null 
                    && request.auth.uid in resource.data.get('collaborators', [])
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentVersion', 'updatedAt', 'updatedBy']);
      
      allow delete: if request.auth != null 
                    && request.auth.uid == resource.data.owner;
      
      // Versions subcollection
      match /versions/{versionId} {
        allow read: if true;  // Public read for app code
        allow write: if request.auth != null 
                     && (request.auth.uid == get(/databases/$(database)/documents/apps/$(appId)).data.owner
                         || request.auth.uid in get(/databases/$(database)/documents/apps/$(appId)).data.get('collaborators', []));
      }
    }
    
    // App drafts - RESTRICTED (only the owner can read/write their drafts)
    match /app-drafts/{draftId} {
      allow read, write: if request.auth != null && 
                            draftId.matches('.*_' + request.auth.uid + '$');
    }
    
    // Global: users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Global: user-secrets collection (OAuth tokens, API keys, etc.)
    match /user-secrets/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Global: app-members collection (manages access to all apps)
    match /app-members/{membershipId} {
      // Users can read their own memberships (pattern: {appId}_{userId})
      allow read: if request.auth != null 
                  && (membershipId.matches('.*_' + request.auth.uid)
                      || get(/databases/$(database)/documents/apps/$(resource.data.appId)).data.owner == request.auth.uid);
      
      // Users can create their own membership (for open apps)
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && membershipId == request.resource.data.appId + '_' + request.auth.uid
                    && (get(/databases/$(database)/documents/apps/$(request.resource.data.appId)).data.get('accessMode', 'open') == 'open'
                        || get(/databases/$(database)/documents/apps/$(request.resource.data.appId)).data.owner == request.auth.uid);
      
      // Users can update their own lastVisitedAt
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid
                    && membershipId.matches('.*_' + request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastVisitedAt']);
      
      // App owners can manage all memberships for their apps
      allow write: if request.auth != null 
                   && get(/databases/$(database)/documents/apps/$(request.resource.data.appId)).data.owner == request.auth.uid;
    }
    
    // Components collection - read/write for authenticated users [DEPRECATED]
    match /components/{componentId} {
      allow read, write: if request.auth != null;
    }

    // Functions collection - read/write for authenticated users
    match /functions/{functionId} {
      allow read, write: if request.auth != null;
    }
    
    // Tasks and schedules collection - read/write for authenticated users
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }
    match /schedules/{scheduleId} {
      allow read, write: if request.auth != null;
    }
    

    // MAGIC: Namespaced app collections (scales to infinite apps!)
    // Pattern: {appId}_{collectionName}/{docId}
    match /{collection}/{docId} {
      // Only allow if collection follows namespace pattern
      allow read: if collection.matches('.*_.*')  // Has underscore
                  && canAccessApp(getAppIdFromCollection(collection));
      
      allow write: if collection.matches('.*_.*')  // Has underscore
                   && canWriteToApp(getAppIdFromCollection(collection));
    }
        
    // Catch-all rule: block everything else (security by default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
