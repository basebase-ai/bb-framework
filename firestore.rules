rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Extract app-id from collection name
    function getAppIdFromCollection(collection) {
      // "teg-app_ideas" → "teg-app"
      return collection.split('_')[0];
    }
    
    // Helper function: Check if user is verified (email, phone, or OAuth provider)
    // - Email/password users must have verified their email
    // - Phone users are verified by completing SMS flow
    // - Google/OAuth users are pre-verified by provider
    function isVerifiedUser() {
      return request.auth != null
             && (request.auth.token.email_verified == true
                 || request.auth.token.phone_number != null);
    }
    
    // Helper function: Check if user has active membership to read app data
    function canAccessApp(appId) {
      return request.auth != null
             && isVerifiedUser()
             && (get(/databases/$(database)/documents/apps/$(appId)).data.owner == request.auth.uid
                 || (exists(/databases/$(database)/documents/app-members/$(appId + '_' + request.auth.uid))
                     && get(/databases/$(database)/documents/app-members/$(appId + '_' + request.auth.uid)).data.status == 'active')
                 || get(/databases/$(database)/documents/apps/$(appId)).data.get('accessMode', 'open') == 'open');
    }
    
    // Helper function: Check if user can write to app collections
    function canWriteToApp(appId) {
      return request.auth != null
             && isVerifiedUser()
             && (get(/databases/$(database)/documents/apps/$(appId)).data.owner == request.auth.uid
                 || (exists(/databases/$(database)/documents/app-members/$(appId + '_' + request.auth.uid))
                     && get(/databases/$(database)/documents/app-members/$(appId + '_' + request.auth.uid)).data.status == 'active'
                     && get(/databases/$(database)/documents/app-members/$(appId + '_' + request.auth.uid)).data.role in ['admin', 'member']));
    }

    // Global: apps collection
    match /apps/{appId} {
      allow read: if true;  // Anyone can read app metadata
      allow create: if request.auth != null 
                    && isVerifiedUser()
                    && request.resource.data.owner == request.auth.uid;
      
      // Owners can update anything
      allow update: if request.auth != null 
                    && isVerifiedUser()
                    && request.auth.uid == resource.data.owner;
      
      // Collaborators can update version pointer when committing code
      allow update: if request.auth != null 
                    && isVerifiedUser()
                    && request.auth.uid in resource.data.get('collaborators', [])
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentVersion', 'updatedAt', 'updatedBy']);
      
      // publicEdit apps: any verified user can update the version pointer
      allow update: if request.auth != null 
                    && isVerifiedUser()
                    && resource.data.get('publicEdit', false) == true
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentVersion', 'updatedAt', 'updatedBy']);
      
      allow delete: if request.auth != null 
                    && isVerifiedUser()
                    && request.auth.uid == resource.data.owner;
      
      // Versions subcollection
      match /versions/{versionId} {
        allow read: if true;  // Public read for app code
        allow write: if request.auth != null 
                     && isVerifiedUser()
                     && (get(/databases/$(database)/documents/apps/$(appId)).data.get('publicEdit', false) == true
                         || request.auth.uid == get(/databases/$(database)/documents/apps/$(appId)).data.owner
                         || request.auth.uid in get(/databases/$(database)/documents/apps/$(appId)).data.get('collaborators', []));
      }
      
      // Drafts subcollection (for Builder app preview)
      match /drafts/{draftId} {
        allow read: if true;  // Public read for preview iframe
        allow write: if request.auth != null 
                     && isVerifiedUser()
                     && (get(/databases/$(database)/documents/apps/$(appId)).data.get('publicEdit', false) == true
                         || request.auth.uid == get(/databases/$(database)/documents/apps/$(appId)).data.owner
                         || request.auth.uid in get(/databases/$(database)/documents/apps/$(appId)).data.get('collaborators', []));
      }
    }
    
    // App drafts - RESTRICTED (only verified owner can read/write their drafts)
    match /app-drafts/{draftId} {
      allow read, write: if request.auth != null 
                         && isVerifiedUser()
                         && draftId.matches('.*_' + request.auth.uid + '$');
    }
    
    // Global: users collection
    // Note: Users can read/write their own profile even before verification
    // This allows the verification flow to work (storing profile during sign-up)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Global: user-secrets collection (OAuth tokens, API keys, etc.)
    match /user-secrets/{userId} {
      allow read, write: if request.auth != null 
                         && request.auth.uid == userId
                         && isVerifiedUser();
    }
    
    // Global: app-secrets collection (API keys, tokens for apps)
    // Only app owner can read/write from client; server functions use Admin SDK (bypasses rules)
    match /app-secrets/{appId} {
      allow read, write: if request.auth != null 
                         && isVerifiedUser()
                         && get(/databases/$(database)/documents/apps/$(appId)).data.owner == request.auth.uid;
    }
    
    // Global: app-members collection (manages access to all apps)
    match /app-members/{membershipId} {
      // Users can read their own memberships (pattern: {appId}_{userId})
      // Must be verified to read memberships
      allow read: if request.auth != null 
                  && isVerifiedUser()
                  && (membershipId.matches('.*_' + request.auth.uid)
                      || get(/databases/$(database)/documents/apps/$(resource.data.appId)).data.owner == request.auth.uid);
      
      // Users can create their own membership (for open apps)
      // Must be verified to join apps
      allow create: if request.auth != null 
                    && isVerifiedUser()
                    && request.resource.data.userId == request.auth.uid
                    && membershipId == request.resource.data.appId + '_' + request.auth.uid
                    && (get(/databases/$(database)/documents/apps/$(request.resource.data.appId)).data.get('accessMode', 'open') == 'open'
                        || get(/databases/$(database)/documents/apps/$(request.resource.data.appId)).data.owner == request.auth.uid);
      
      // Users can update their own lastVisitedAt
      allow update: if request.auth != null 
                    && isVerifiedUser()
                    && resource.data.userId == request.auth.uid
                    && membershipId.matches('.*_' + request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastVisitedAt']);
      
      // App owners can manage all memberships for their apps
      allow write: if request.auth != null 
                   && isVerifiedUser()
                   && get(/databases/$(database)/documents/apps/$(request.resource.data.appId)).data.owner == request.auth.uid;
    }
    
    // Components collection - read/write for verified users [DEPRECATED]
    match /components/{componentId} {
      allow read, write: if request.auth != null && isVerifiedUser();
    }

    // Functions collection - read/write for verified users
    match /functions/{functionId} {
      allow read, write: if request.auth != null && isVerifiedUser();
    }
    
    // Tasks and schedules collection - read/write for verified users
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && isVerifiedUser();
    }
    match /schedules/{scheduleId} {
      allow read, write: if request.auth != null && isVerifiedUser();
    }
    

    // PUBLIC namespaced collections: {appId}_{name}_public
    // These are readable by anyone (no auth required), writable by verified users
    // Example: www_integrations_public, myapp_blog_public
    match /{collection}/{docId} {
      allow read: if collection.matches('.*_.*_public$');
      allow write: if collection.matches('.*_.*_public$')
                   && request.auth != null 
                   && isVerifiedUser();
    }

    // MAGIC: Namespaced app collections (scales to infinite apps!)
    // Pattern: {appId}_{collectionName}/{docId}
    match /{collection}/{docId} {
      // Only allow if collection follows namespace pattern
      allow read: if collection.matches('.*_.*')  // Has underscore
                  && canAccessApp(getAppIdFromCollection(collection));
      
      allow write: if collection.matches('.*_.*')  // Has underscore
                   && canWriteToApp(getAppIdFromCollection(collection));
    }
    
    // Subcollections of namespaced collections (e.g., writebase_documents/{docId}/content/{subDocId})
    // Using recursive wildcard to match any depth
    match /{collection}/{docId}/{path=**} {
      allow read: if collection.matches('.*_.*')
                  && canAccessApp(getAppIdFromCollection(collection));
      
      allow write: if collection.matches('.*_.*')
                   && canWriteToApp(getAppIdFromCollection(collection));
    }
        
    // Catch-all rule: block everything else (security by default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
